<div class="flex space-x-2">
  {{#each this.themes as |theme|}}
    <button
      type="button"
      class="px-4 py-2 rounded {{if (eq this.theme.currentTheme theme) 'bg-primary text-white' 'bg-gray-200 text-gray-800'}}"
      {{on "click" (fn this.setTheme theme)}}
    >
      {{theme}}
    </button>
  {{/each}}
</div>