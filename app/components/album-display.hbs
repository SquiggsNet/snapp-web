<div class="divide-y divide-gray-200 overflow-hidden rounded-lg bg-white shadow">
  <Snui::Header @title={{@label}} />
  <div class="px-4 py-5 sm:px-6">
    <div class="flex gap-2">
      <div>
        <span class="font-medium">Artists:</span>
        {{#each @artists as |artist|}}
          {{artist.label}}
        {{/each}}
      </div>
      <div>
        <span class="font-medium">Format:</span>
        {{@format.size}}" {{@format.speed}}rpm
      </div>
      <div>
        <span class="font-medium">Year:</span> {{@year}}
      </div>
    </div>
  </div>
  <div class="px-4 py-5 sm:p-6">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Track #</th>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Title</th>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Length</th>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Artists</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              {{#each @songs as |song|}}
                <tr>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{song.number}}</td>
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-primary-900 sm:pl-6">
                    <LinkTo @route="music.topic.entry" @model={{song.id}}>{{song.label}}</LinkTo>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    {{format-duration song.length}}
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    {{#let (last song.artists) as |lastArtist|}}
                      {{#each song.artists as |artist|}}
                        {{artist.label}}{{if (not-eq artist lastArtist) ", "}}
                      {{/each}}
                    {{/let}}
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
{{yield}}