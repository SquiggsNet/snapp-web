{{page-title "SNApp"}}

<Snui::AppWrapper>
  <:header>
    <Snui::NavBar>
      <:mainMenu>
        {{!-- <Snui::Logo @imgSrc="/imgs/squiggsnet.png" @alt="SNApp"/> --}}
        <div class="flex-shrink-0">
          <img class="h-8 w-8 rounded-full" src="/imgs/squiggsnet.png" alt="">
        </div>
        <Snui::DesktopMenu>
          <:links>
            {{#each this.menuItems as |item|}}
              <Snui::NavLink::Main @route={{item.route}} @isCurrent={{item.isCurrent}}>{{item.label}}</Snui::NavLink::Main>
            {{/each}}
          </:links>
        </Snui::DesktopMenu>
      </:mainMenu>

      <:userMenu>
        <Snui::UserMenu @imgSrc="/imgs/squiggs.jpg">
          <:menuItems>
            {{#each this.profileMenuItems as |item index|}}
              <Snui::NavLink::MenuItem @route={{item.route}} @index={{index}}>{{item.label}}</Snui::NavLink::MenuItem>
            {{/each}}
          </:menuItems>
        </Snui::UserMenu>
        <Snui::MobileMenuButton @toggleMobileMenu={{this.toggleMobileMenu}} />
      </:userMenu>

      <:mobileMenu>
        {{#if this.isMobileMenuOpen}}
          <Snui::MobileMenu @imgSrc="/imgs/squiggs.jpg">
            <:menuItems>
              {{#each this.menuItems as |item|}}
                <Snui::NavLink::Mobile @route={{item.route}} @isCurrent={{item.isCurrent}}>{{item.label}}</Snui::NavLink::Mobile>
              {{/each}}
            </:menuItems>
            <:profileMenuItems>
              {{#each this.profileMenuItems as |item|}}
                <Snui::NavLink::Mobile @route={{item.route}} @isCurrent={{item.isCurrent}}>{{item.label}}</Snui::NavLink::Mobile>
              {{/each}}
            </:profileMenuItems>
          </Snui::MobileMenu>
        {{/if}}
      </:mobileMenu>

    </Snui::NavBar>

  </:header>

  <:main>
    {{outlet}}
  </:main>

</Snui::AppWrapper>
