{{page-title this.model.topic_id}}

<div class="flex flex-col md:flex-row">
  <div class="md:hidden">
    {{outlet}}
  </div>

  <div class="px-4 sm:px-6 lg:px-8">
    <div class="sm:flex sm:items-center">
      <div class="sm:flex-auto">
        <p class="mt-2 text-sm text-primary-700">A list of all the {{this.model.topic_id}} in your account collection.</p>
      </div>
    </div>
    <div class="mt-8 flow-root">
      <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
          <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
            <table class="min-w-full divide-y divide-gray-300">
              <thead class="bg-gray-50">
                <tr>
                  {{#if (eq this.model.topic_id "songs")}}
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Track #</th>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Title</th>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Length</th>
                  {{else if (eq this.model.topic_id "vinyls")}}
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Title</th>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Format</th>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Year</th>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Country</th>
                  {{else if (eq this.model.topic_id "artists")}}
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Name</th>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Type</th>
                  {{/if}}
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">
                {{#each this.model.data as |data|}}
                  <tr>
                    {{#if (eq this.model.topic_id "songs")}}
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{data.number}}</td>
                      <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-primary-900 sm:pl-6">
                        <LinkTo @route="music.topic.entry" @model={{data.id}}>{{data.label}}</LinkTo>
                      </td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{format-duration data.length}}</td>
                    {{else if (eq this.model.topic_id "vinyls")}}
                      <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-primary-900 sm:pl-6">
                        <LinkTo @route="music.topic.entry" @model={{data.id}}>{{data.label}}</LinkTo>
                      </td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{data.format.size}}" {{data.format.speed}}rpm</td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{data.year}}</td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{data.country}}</td>
                    {{else if (eq this.model.topic_id "artists")}}
                      <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-primary-900 sm:pl-6">
                        <LinkTo @route="music.topic.entry" @model={{data.id}}>{{data.label}}</LinkTo>
                      </td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{data.type}}</td>
                    {{/if}}
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hidden md:block">
    {{outlet}}
  </div>
</div>