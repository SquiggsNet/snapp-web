{{page-title this.model.topic_id}}
{{!-- <div class="flex-grow">
  <Snui::Header @title={{this.model.topic_id}} />
</div> --}}

<div class="flex flex-col md:flex-row">
  <div class="md:hidden">
    {{outlet}}
  </div>

  <div class="px-4 sm:px-6 lg:px-8">
    <div class="sm:flex sm:items-center">
      <div class="sm:flex-auto">
        {{!-- <h1 class="text-base font-semibold leading-6 text-primary-900">{{this.model.topic_id}}</h1> --}}
        <p class="mt-2 text-sm text-primary-700">A list of all the {{this.model.topic_id}} in your account collection.</p>
      </div>
      {{!-- <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
        <button type="button" class="block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Add user</button>
      </div> --}}
    </div>
    <div class="mt-8 flow-root">
      <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
          <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
            <table class="min-w-full divide-y divide-gray-300">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Name</th>
                  <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Disc</th>
                  <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Side</th>
                  <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-primary-900 sm:pl-6">Length</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">
                {{#each this.model.data as |data|}}
                  <tr>
                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-primary-900 sm:pl-6"><LinkTo  @route="music.topic.entry" @model={{data.id}}>{{data.label}}</LinkTo></td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{data.disc}}</td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{data.side}}</td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{data.length}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hidden md:block">
    {{outlet}}
  </div>
</div>